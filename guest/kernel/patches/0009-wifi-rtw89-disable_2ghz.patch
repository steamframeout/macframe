From: steamac <steamac@localhost>
Subject: [PATCH] wifi: rtw89: disable_2ghz for the Steam Frame Wireless Adapter

The adapter's USB 3 link drops whenever it transmits on 2.4 GHz, which every scan does: "rtw89_hw_scan_offload
failed ret -110", a SuperSpeed reset and the device re-enumerating, about 25 times a minute (and over USB/IP each
one tears the attachment down). The headset link is 6 GHz only, so disable_2ghz=Y marks the 2.4 GHz channels
disabled before the wiphy is registered.

From https://github.com/Davenport-Physics/rtw89-steam-frame (patches/0002-disable-2ghz.patch), GPL-2.0 OR
BSD-3-Clause like rtw89; paths rebased onto the kernel tree. MacFrame sets rtw89_core.disable_2ghz=1 on the
kernel command line.
---
--- a/drivers/net/wireless/realtek/rtw89/core.c
+++ b/drivers/net/wireless/realtek/rtw89/core.c
@@ -25,6 +25,11 @@
 module_param_named(disable_ps_mode, rtw89_disable_ps_mode, bool, 0644);
 MODULE_PARM_DESC(disable_ps_mode, "Set Y to disable low power mode");
 
+static bool rtw89_disable_2ghz;
+module_param_named(disable_2ghz, rtw89_disable_2ghz, bool, 0444);
+MODULE_PARM_DESC(disable_2ghz,
+		 "Set Y to disable all 2.4 GHz channels (no scanning or transmitting there). Applied when the adapter is probed.");
+
 #define RTW89_DEF_CHAN(_freq, _hw_val, _flags, _band)	\
 	{ .center_freq = _freq, .hw_value = _hw_val, .flags = _flags, .band = _band, }
 #define RTW89_DEF_CHAN_2G(_freq, _hw_val)	\
@@ -6329,7 +6334,7 @@
 	struct ieee80211_hw *hw = rtwdev->hw;
 	struct ieee80211_supported_band *sband;
 	u8 support_bands = rtwdev->chip->support_bands;
-	int ret;
+	int ret, i;
 
 	if (support_bands & BIT(NL80211_BAND_2GHZ)) {
 		sband = rtw89_core_sband_dup(rtwdev, &rtw89_sband_2ghz);
@@ -6339,6 +6344,12 @@
 		ret = rtw89_init_he_eht_cap(rtwdev, NL80211_BAND_2GHZ, sband);
 		if (ret)
 			return ret;
+		if (rtw89_disable_2ghz) {
+			/* flags set before wiphy registration are kept as orig_flags */
+			for (i = 0; i < sband->n_channels; i++)
+				sband->channels[i].flags |= IEEE80211_CHAN_DISABLED;
+			rtw89_info(rtwdev, "2.4 GHz channels disabled by disable_2ghz\n");
+		}
 		hw->wiphy->bands[NL80211_BAND_2GHZ] = sband;
 	}
 
